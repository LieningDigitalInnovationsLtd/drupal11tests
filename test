<?php

namespace Drupal\webform_normalizer\Normalizer;

use Drupal\webform\WebformInterface;
use Symfony\Component\Serializer\Normalizer\NormalizerInterface;

class WebformNormalizer implements NormalizerInterface {

  /**
   * {@inheritdoc}
   */
  public function normalize(mixed $data, ?string $format = NULL, array $context = []): array {
    assert($data instanceof WebformInterface);

    return [
      'id' => $data->id(),
      'uuid' => $data->uuid(),
      'title' => $data->label(),
      'description' => $data->getDescription(),
      'status' => $data->status(),
      'created' => $data->getCreatedTime(),
      'changed' => $data->getChangedTime(),
      'elements' => $this->getElements($data),
    ];
  }

  /**
   * {@inheritdoc}
   */
  public function supportsNormalization(mixed $data, ?string $format = NULL, array $context = []): bool {
    return $data instanceof WebformInterface;
  }

  /**
   * {@inheritdoc}
   */
  public function getSupportedTypes(?string $format): array {
    return [
      WebformInterface::class => TRUE,
    ];
  }

  /**
   * Extract webform elements.
   */
  protected function getElements(WebformInterface $webform): array {
    $elements = $webform->getElementsDecodedAndFlattened();

    $result = [];

    foreach ($elements as $key => $element) {
      $result[$key] = [
        'type' => $element['#type'] ?? NULL,
        'title' => $element['#title'] ?? NULL,
        'required' => !empty($element['#required']),
      ];
    }

    return $result;
  }

}
