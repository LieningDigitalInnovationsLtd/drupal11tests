<?php

namespace Drupal\my_module\Normalizer;

use Drupal\Core\Form\FormBuilderInterface;
use Drupal\Core\Render\RendererInterface;
use Drupal\webform\WebformInterface;
use Drupal\webform\WebformSubmissionForm;
use Symfony\Component\Serializer\Normalizer\NormalizerInterface;
use Symfony\Component\DependencyInjection\ContainerInterface;

class WebformNormalizer implements NormalizerInterface {

  public function __construct(
    protected FormBuilderInterface $formBuilder,
    protected RendererInterface $renderer,
  ) {}

  public static function create(ContainerInterface $container): static {
    return new static(
      $container->get('form_builder'),
      $container->get('renderer'),
    );
  }

  public function normalize(mixed $data, ?string $format = NULL, array $context = []): array {
    assert($data instanceof WebformInterface);

    $form = $this->formBuilder->getForm(
      WebformSubmissionForm::class,
      $data
    );

    $html = $this->renderer->renderRoot($form);

    return [
      'id' => $data->id(),
      'uuid' => $data->uuid(),
      'title' => $data->label(),
      'description' => $data->getDescription(),
      'status' => $data->status(),
      'elements' => $data->getElementsDecodedAndFlattened(),
      'html' => (string) $html,
    ];
  }

  public function supportsNormalization(mixed $data, ?string $format = NULL, array $context = []): bool {
    return $data instanceof WebformInterface;
  }

  public function getSupportedTypes(?string $format): array {
    return [
      WebformInterface::class => TRUE,
    ];
  }

}
