<?php

use Drupal\Core\Form\FormStateInterface;
use Drupal\node\NodeInterface;

/**
 * Implements hook_form_node_form_alter().
 */
function mymodule_form_node_form_alter(array &$form, FormStateInterface $form_state, $form_id): void {
  $node = $form_state->getFormObject()->getEntity();

  if (!$node instanceof NodeInterface) {
    return;
  }

  foreach ($node->getFieldDefinitions() as $field_name => $definition) {
    if (
      $definition->getType() !== 'entity_reference_revisions' ||
      $definition->getSetting('target_type') !== 'paragraph'
    ) {
      continue;
    }

    if (!isset($form[$field_name]['widget'])) {
      continue;
    }

    $paragraph_types = [];

    foreach ($form[$field_name]['widget'] as $delta => $widget) {
      if (!is_numeric($delta)) {
        continue;
      }

      // Existing paragraphs.
      if (isset($widget['#paragraph'])) {
        $paragraph_types[] = $widget['#paragraph']->bundle();
      }

      // Newly added paragraphs through AJAX.
      if (isset($widget['entity'])) {
        $entity = $widget['entity'];

        if ($entity->getEntityTypeId() === 'paragraph') {
          $paragraph_types[] = $entity->bundle();
        }
      }

      // Fallback: Paragraph type stored in widget state.
      if (!empty($widget['top']['paragraph_type']['#value'])) {
        $paragraph_types[] = $widget['top']['paragraph_type']['#value'];
      }
    }

    // Fallback to saved entity values if the widget is empty.
    if (!$paragraph_types && $node->hasField($field_name)) {
      foreach ($node->get($field_name)->referencedEntities() as $paragraph) {
        $paragraph_types[] = $paragraph->bundle();
      }
    }

    $paragraph_types = array_unique($paragraph_types);

    $form[$field_name]['widget']['#attributes']['data-paragraphs'] = implode(' ', $paragraph_types);
  }
}
