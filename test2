<?php

/**
 * Implements hook_webform_ui_element_types_alter().
 */
function my_module_webform_ui_element_types_alter(array &$element_types): void {
  $allowed = [
    'textfield',
    'textarea',
    'email',
    'select',
    'radios',
    'checkboxes',
    'checkbox',
  ];

  foreach (array_keys($element_types) as $id) {
    if (!in_array($id, $allowed, TRUE)) {
      unset($element_types[$id]);
    }
  }
}
