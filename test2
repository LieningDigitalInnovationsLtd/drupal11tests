<?php

use Drupal\webform\WebformInterface;

/**
 * Implements hook_webform_insert().
 */
function my_module_webform_insert(WebformInterface $webform): void {
  $node_storage = \Drupal::entityTypeManager()
    ->getStorage('node');

  $node = $node_storage->create([
    'type' => 'webform',
    'title' => $webform->label(),
    'field_webform' => [
      'target_id' => $webform->id(),
    ],
  ]);

  $node->save();
}
