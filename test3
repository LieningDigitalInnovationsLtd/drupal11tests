use Drupal\Core\Asset\AttachedAssets;

$attached_assets = new AttachedAssets();
$attached_assets->setLibraries([
  'webform/webform',
]);

$css_assets = \Drupal::service('asset.resolver')
  ->getCssAssets($attached_assets, TRUE);

$styles = [];

foreach ($css_assets as $asset) {
  $styles[] = $asset['data'];
}

return $styles;
