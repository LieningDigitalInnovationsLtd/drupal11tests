$library = 'webform/webform';

[$extension, $name] = explode('/', $library, 2);

$definition = \Drupal::service('library.discovery')
  ->getLibraryByName($extension, $name);

$styles = [];

foreach ($definition['css'] ?? [] as $group) {
  foreach ($group as $file => $options) {
    $styles[] = '/' . \Drupal::service('extension.path.resolver')
      ->getPath($extension) . '/' . $file;
  }
}

return $styles;
