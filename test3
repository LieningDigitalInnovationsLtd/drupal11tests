$attachments = $build['#attached']['library'] ?? [];

$libraryDiscovery = \Drupal::service('library.discovery');

$styles = [];

foreach ($attachments as $library) {
  [$extension, $name] = explode('/', $library, 2);

  $definition = $libraryDiscovery->getLibraryByName($extension, $name);

  if (!$definition) {
    continue;
  }

  foreach ($definition['css'] ?? [] as $group) {
    foreach ($group as $file => $options) {
      if (str_starts_with($file, 'http://') || str_starts_with($file, 'https://')) {
        $styles[] = $file;
      }
      else {
        $styles[] = file_url_transform_relative(file_create_url($file));
      }
    }
  }
}

$styles = array_values(array_unique($styles));
