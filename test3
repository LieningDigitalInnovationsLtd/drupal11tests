$styles = [];

if (!empty($request->query->get('styles'))) {

  /** @var \Drupal\Core\Asset\AssetResolver $asset_resolver */
  $asset_resolver = \Drupal::service('asset.resolver');

  $attachments = $build['#attached'] ?? [];

  // Create a dummy response so Drupal can resolve the attached assets.
  $response = new HtmlResponse();
  $response->setAttachments($attachments);

  $css_assets = $asset_resolver->getCssAssets($response->getAttachments(), TRUE);

  foreach ($css_assets as $asset) {
    if (!empty($asset['data'])) {
      $styles[] = file_url_transform_relative(file_create_url($asset['data']));
    }
  }

  $styles = array_values(array_unique($styles));
}
