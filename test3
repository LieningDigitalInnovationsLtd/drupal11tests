$build = $webform->getSubmissionForm();

$html = $this->renderer->renderRoot($build);

$styles = [];

foreach ($build['#attached']['library'] ?? [] as $library) {

  [$extension, $name] = explode('/', $library, 2);

  $definition = \Drupal::service('library.discovery')
    ->getLibraryByName($extension, $name);

  if (!$definition) {
    continue;
  }

  foreach ($definition['css'] ?? [] as $group) {
    foreach ($group as $file => $options) {

      if (str_starts_with($file, 'http')) {
        $styles[] = $file;
      }
      else {
        $styles[] = base_path() . $file;
      }

    }
  }
}

$styles = array_values(array_unique($styles));
