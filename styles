.webform-ui-elements-table {
  border-collapse: separate;
  border-spacing: 0;

  > tbody > tr:not(.webform-ui-element-type-webform_actions) td {
    background-color: inherit !important;
  }

  > tbody > tr.webform-ui-element-container:nth-child(odd of .webform-ui-element-container) {
    border-top: 3px solid var(--gin-color-green);
    background-color: var(--gin-color-green-lightest) !important;

    & ~ tr:not(.webform-ui-element-container):not(.webform-ui-element-type-webform_actions) {
      background-color: var(--gin-bg-green-light) !important;
    }
  }

  > tbody > tr.webform-ui-element-container:nth-child(even of .webform-ui-element-container) {
    border-top: 3px solid var(--gin-color-primary);
    background-color: var(--gin-color-primary-light) !important;

    & ~ tr:not(.webform-ui-element-container):not(.webform-ui-element-type-webform_actions) {
      background-color: var(--gin-bg-item) !important;
    }
  }
}
